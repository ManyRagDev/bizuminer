{
  "manifest_version": 3,
  "name": "BizuMiner — captura de ofertas",
  "version": "0.3.4",
  "description": "Importa produtos da página aberta do Mercado Livre, Amazon Brasil ou AliExpress para revisão na sua conta BizuMiner, após sua confirmação.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.bizuminer.com.br/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "BizuMiner"
  },
  "content_scripts": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
